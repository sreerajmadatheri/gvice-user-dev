rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.role == "admin";
    }


    // ==========================================
    // ADMINS
    // ==========================================

    match /admins/{adminId} {

      // A user can check only their own admin document.
      allow read: if isAuthenticated()
        && request.auth.uid == adminId;

      // Admin records must be managed through
      // Firebase Console or a trusted backend.
      allow write: if false;
    }


    // ==========================================
    // USERS
    // ==========================================

    match /users/{userId} {

      // ------------------------------------------
      // ADMIN
      // ------------------------------------------

      // Admin can read and write all user profiles.
      allow read, write: if isAdmin();


      // ------------------------------------------
      // NORMAL USER - READ
      // ------------------------------------------

      // User can read their own profile.
      allow read: if isAuthenticated()
        && request.auth.uid == userId;


      // ------------------------------------------
      // NORMAL USER - CREATE
      // ------------------------------------------

      // User can create only their own profile.
      //
      // Protected values:
      // - uid must equal authenticated UID
      // - role must initially be "user"
      //
      allow create: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role == "user";


      // ------------------------------------------
      // NORMAL USER - UPDATE
      // ------------------------------------------

      // User can update their own profile.
      //
      // Protected fields:
      // - uid cannot change
      // - role cannot change
      // - isApproved cannot change
      //
      allow update: if isAuthenticated()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && request.resource.data.isApproved == resource.data.isApproved;


      // ==========================================
      // FCM TOKENS
      // ==========================================

      match /fcmTokens/{tokenId} {

        // User can read their own tokens.
        // Admin can read all tokens.
        allow read: if isAdmin()
          || (
            isAuthenticated()
            && request.auth.uid == userId
          );


        // User can create only their own token.
        allow create: if isAdmin()
          || (
            isAuthenticated()
            && request.auth.uid == userId
            && request.resource.data.userId == request.auth.uid
          );


        // User can update only their own token.
        //
        // The token cannot be transferred
        // to another user.
        allow update: if isAdmin()
          || (
            isAuthenticated()
            && request.auth.uid == userId
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
          );


        // User can remove their own token.
        allow delete: if isAdmin()
          || (
            isAuthenticated()
            && request.auth.uid == userId
          );
      }
    }


    // ==========================================
    // NEWS
    // ==========================================

    match /news/{newsId} {

      // Publicly readable.
      allow read: if true;

      // Only admins can create/update/delete.
      allow write: if isAdmin();
    }


    // ==========================================
    // TENDERS
    // ==========================================

    match /tenders/{tenderId} {

      // Publicly readable.
      allow read: if true;

      // Only admins can create/update/delete.
      allow write: if isAdmin();
    }


    // ==========================================
    // EQUIPMENT
    // ==========================================

    match /equipmentListings/{listingId} {

      // Everyone can view equipment.
      allow read: if true;


      // Admin can create/update/delete anything.
      allow write: if isAdmin();


      // ------------------------------------------
      // NORMAL USER - CREATE
      // ------------------------------------------

      // User can create only their own listing.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;


      // ------------------------------------------
      // NORMAL USER - UPDATE
      // ------------------------------------------

      // User can update only their own listing.
      //
      // Ownership cannot be transferred.
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;


      // ------------------------------------------
      // NORMAL USER - DELETE
      // ------------------------------------------

      // Normal users cannot delete listings.
      allow delete: if isAdmin();
    }


    // ==========================================
    // PROJECTS
    // ==========================================

    match /projects/{projectId} {

      // Publicly readable.
      allow read: if true;

      // Only admins can create/update/delete.
      allow write: if isAdmin();
    }


    // ==========================================
    // AUCTION BIDS
    // ==========================================

    match /auctionBids/{bidId} {

      // ------------------------------------------
      // READ
      // ------------------------------------------

      // Admin can read every bid.
      //
      // Bidder can read their own bids.
      //
      // Seller can read bids received
      // for their own equipment.
      //
      allow read: if isAdmin()
        || (
          isAuthenticated()
          && (
            resource.data.bidderUserId == request.auth.uid
            || resource.data.sellerUserId == request.auth.uid
          )
        );


      // ------------------------------------------
      // CREATE
      // ------------------------------------------

      // A logged-in user can create a bid
      // only for themselves.
      allow create: if isAuthenticated()
        && request.resource.data.bidderUserId == request.auth.uid;


      // ------------------------------------------
      // UPDATE
      // ------------------------------------------

      // Admin can update anything.
      //
      // Bidder can update their own bid,
      // but cannot change:
      // - bidder identity
      // - seller identity
      // - status
      //
      // Seller can update allowed fields without
      // changing the bid amount.
      //
      allow update: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.bidderUserId == request.auth.uid
          && request.resource.data.bidderUserId
              == resource.data.bidderUserId
          && request.resource.data.sellerUserId
              == resource.data.sellerUserId
          && request.resource.data.status
              == resource.data.status
        )
        || (
          isAuthenticated()
          && resource.data.sellerUserId == request.auth.uid
          && request.resource.data.bidderUserId
              == resource.data.bidderUserId
          && request.resource.data.sellerUserId
              == resource.data.sellerUserId
          && request.resource.data.bidAmount
              == resource.data.bidAmount
        );


      // ------------------------------------------
      // DELETE
      // ------------------------------------------

      // Admin can delete any bid.
      // Bidder can delete their own bid.
      allow delete: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.bidderUserId == request.auth.uid
        );
    }
  }
}