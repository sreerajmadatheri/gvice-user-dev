rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.role == "admin";
    }


    // ==========================================
    // ADMINS
    // ==========================================

    match /admins/{adminId} {
      allow read: if isAuthenticated()
        && request.auth.uid == adminId;

      allow write: if false;
    }


    // ==========================================
    // USERS
    // ==========================================

    match /users/{userId} {
      allow read, write: if isAdmin()
        || (
          isAuthenticated()
          && request.auth.uid == userId
        );
    }


    // ==========================================
    // NEWS
    // ==========================================

    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ==========================================
    // TENDERS
    // ==========================================

    match /tenders/{tenderId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ==========================================
    // EQUIPMENT
    // ==========================================

    match /equipmentListings/{listingId} {

      // Everyone can view equipment.
      allow read: if true;

      // Admin can create, update and delete any equipment.
      allow create, update, delete: if isAdmin();

      // Normal authenticated user can create
      // equipment only for themselves.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Normal authenticated user can update
      // only their own equipment.
      //
      // Ownership cannot be transferred.
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;
    }


    // ==========================================
    // PROJECTS
    // ==========================================

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ==========================================
    // AUCTION BIDS
    // ==========================================

    match /auctionBids/{bidId} {

      // ----------------------------------------
      // READ
      // ----------------------------------------
      //
      // Admin:
      //   Can read all bids.
      //
      // Bidder:
      //   Can read their own bids.
      //
      // Seller:
      //   Can read bids received for their equipment.
      //
      allow read: if isAdmin()
        || (
          isAuthenticated()
          && (
            resource.data.bidderUserId == request.auth.uid
            || resource.data.sellerUserId == request.auth.uid
          )
        );


      // ----------------------------------------
      // CREATE
      // ----------------------------------------
      //
      // A logged-in user can create a bid only
      // for themselves.
      //
      allow create: if isAuthenticated()
        && request.resource.data.bidderUserId == request.auth.uid;


      // ----------------------------------------
      // UPDATE
      // ----------------------------------------
      //
      // Admin:
      //   Can update anything.
      //
      // Bidder:
      //   Can update their own bid amount/details,
      //   but cannot change bidder identity,
      //   seller identity or status.
      //
      // Seller:
      //   Can change the bid status,
      //   but cannot change bidder, seller or
      //   bid amount.
      //
      allow update: if isAdmin()

        || (
          isAuthenticated()
          && resource.data.bidderUserId == request.auth.uid
          && request.resource.data.bidderUserId
              == resource.data.bidderUserId
          && request.resource.data.sellerUserId
              == resource.data.sellerUserId
          && request.resource.data.status
              == resource.data.status
        )

        || (
          isAuthenticated()
          && resource.data.sellerUserId == request.auth.uid
          && request.resource.data.bidderUserId
              == resource.data.bidderUserId
          && request.resource.data.sellerUserId
              == resource.data.sellerUserId
          && request.resource.data.bidAmount
              == resource.data.bidAmount
        );


      // ----------------------------------------
      // DELETE
      // ----------------------------------------
      //
      // Admin can delete any bid.
      //
      // Bidder can delete their own bid.
      //
      // Seller cannot delete a received bid.
      //
      allow delete: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.bidderUserId == request.auth.uid
        );
    }
  }
}