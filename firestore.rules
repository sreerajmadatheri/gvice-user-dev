rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && exists(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        )
        && get(
          /databases/$(database)/documents/admins/$(request.auth.uid)
        ).data.role == "admin";
    }


    // ==========================================
    // ADMINS
    // ==========================================

    match /admins/{adminId} {

      // User can check only their own admin document.
      allow read: if isAuthenticated()
        && request.auth.uid == adminId;

      // Admin records must be managed manually
      // through Firebase Console or trusted backend.
      allow write: if false;
    }


    // ==========================================
    // USERS
    // ==========================================

    match /users/{userId} {

      // User can manage their own profile.
      // Admin can manage all profiles.
      allow read, write: if isAdmin()
        || (
          isAuthenticated()
          && request.auth.uid == userId
        );

      // ==========================================
      // FCM TOKENS
      // ==========================================

      match /fcmTokens/{tokenId} {

        // User can read their own tokens.
        // Admin can read all tokens.
        allow read: if isAdmin()
          || (
            isAuthenticated()
            && request.auth.uid == userId
          );

        // User can create only their own token.
        allow create: if isAdmin()
          || (
            isAuthenticated()
            && request.auth.uid == userId
            && request.resource.data.userId == request.auth.uid
          );

        // User can update only their own token.
        // The token cannot be transferred to another user.
        allow update: if isAdmin()
          || (
            isAuthenticated()
            && request.auth.uid == userId
            && resource.data.userId == request.auth.uid
            && request.resource.data.userId == request.auth.uid
          );

        // User can remove their own token.
        allow delete: if isAdmin()
          || (
            isAuthenticated()
            && request.auth.uid == userId
          );
      }
    }


    // ==========================================
    // NEWS
    // ==========================================

    match /news/{newsId} {

      // Publicly readable.
      allow read: if true;

      // Only admins can create/update/delete.
      allow write: if isAdmin();
    }


    // ==========================================
    // TENDERS
    // ==========================================

    match /tenders/{tenderId} {

      // Publicly readable.
      allow read: if true;

      // Only admins can create/update/delete.
      allow write: if isAdmin();
    }


    // ==========================================
    // EQUIPMENT
    // ==========================================

    match /equipmentListings/{listingId} {

      // Everyone can view equipment.
      allow read: if true;

      // Admin can create/update/delete anything.
      allow write: if isAdmin();

      // Normal authenticated user can create
      // only a listing belonging to themselves.
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;

      // Normal user can update only their own listing
      // and cannot transfer ownership to another user.
      allow update: if isAuthenticated()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid;

      // Normal users cannot delete listings.
      allow delete: if isAdmin();
    }


    // ==========================================
    // PROJECTS
    // ==========================================

    match /projects/{projectId} {

      // Publicly readable.
      allow read: if true;

      // Only admins can create/update/delete.
      allow write: if isAdmin();
    }


    // ==========================================
    // AUCTION BIDS
    // ==========================================

    match /auctionBids/{bidId} {

      // Admin can read every bid.
      // Bidder can read their own bids.
      // Seller can read bids received for their own equipment.
      allow read: if isAdmin()
        || (
          isAuthenticated()
          && (
            resource.data.bidderUserId == request.auth.uid
            || resource.data.sellerUserId == request.auth.uid
          )
        );

      // A logged-in user can create a bid only for themselves.
      allow create: if isAuthenticated()
        && request.resource.data.bidderUserId == request.auth.uid;

      // Bidder can update their own bid,
      // but cannot change bidder identity or seller identity or status.
      allow update: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.bidderUserId == request.auth.uid
          && request.resource.data.bidderUserId == resource.data.bidderUserId
          && request.resource.data.sellerUserId == resource.data.sellerUserId
          && request.resource.data.status == resource.data.status
        )
        || (
          isAuthenticated()
          && resource.data.sellerUserId == request.auth.uid
          && request.resource.data.bidderUserId == resource.data.bidderUserId
          && request.resource.data.sellerUserId == resource.data.sellerUserId
          && request.resource.data.bidAmount == resource.data.bidAmount
        );

      // Admin can delete any bid.
      // Bidder can delete their own bid.
      allow delete: if isAdmin()
        || (
          isAuthenticated()
          && resource.data.bidderUserId == request.auth.uid
        );
    }
  }
}